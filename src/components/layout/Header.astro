---
import { NAV, SITE } from '@/config/site';
import { PROFILE } from '@/data/profile';

const consultHref = `mailto:${PROFILE.email}?subject=${encodeURIComponent('Free consultation')}`;
---

<header class="header" data-header data-bp="Header.astro">
  <span class="progress" aria-hidden="true" data-progress></span>
  <!-- Top promo strip: folds away once the page is scrolled, so it never covers content. -->
  <div class="promo">
    <p class="container promo__inner">
      <span class="promo__text"><span aria-hidden="true">💬</span> <strong>Free consultation</strong> for your WordPress project. No obligation.</span>
      <a href={consultHref} class="promo__link">Book free consultation →</a>
      <a href="/hire/" class="promo__link promo__link--hire">Hire me</a>
    </p>
  </div>
  <div class="container header__inner">
    <a href="/" class="logo" aria-label={`${SITE.name}, home`}>
      <span class="logo__mark" aria-hidden="true">M<span>/</span></span>
      <span class="logo__text mono">maneesh<span class="logo__dim">.dev</span></span>
    </a>

    <nav class="nav" aria-label="Main">
      <ul class="nav__list" id="nav-list">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class="nav__link" data-nav-link>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <button class="icon-btn kbd-btn mono" type="button" data-palette-open aria-label="Open quick navigation">
        <span aria-hidden="true">/</span>
        <span class="kbd-btn__label">Jump to</span>
      </button>
      <button class="icon-btn bp-btn" type="button" data-blueprint-toggle aria-pressed="false" aria-label="Blueprint mode: see how this page is engineered" title="Blueprint mode (B)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 9h18M3 15h18M9 3v18M15 3v18"></path><rect x="3" y="3" width="18" height="18" rx="2"></rect></svg>
      </button>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle light and dark theme">
        <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
      </button>
      <a href="/hire/" class="hire-btn" data-magnetic>
        <span class="live-dot hire-btn__dot" aria-hidden="true"></span>
        Hire me
      </a>
      <button class="icon-btn burger" type="button" data-burger aria-label="Open menu" aria-expanded="false" aria-controls="nav-list">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding-block: 14px;
    transition: background-color 0.3s, border-color 0.3s, padding 0.3s var(--ease-out);
    border-bottom: 1px solid transparent;
  }
  .promo {
    margin: -14px 0 12px;
    max-height: 40px;
    overflow: hidden;
    background: var(--grad-btn);
    color: #fff;
    font-size: 13.5px;
    transition: max-height 0.3s var(--ease-out), margin 0.3s var(--ease-out);
  }
  .promo__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px 18px;
    min-height: 36px;
    flex-wrap: wrap;
  }
  .promo__link {
    color: #fff;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }
  .promo__link--hire {
    padding: 2px 12px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.2);
    text-decoration: none;
  }
  .header.is-scrolled .promo {
    max-height: 0;
    margin-block: -10px 0;
  }
  @media (max-width: 640px) {
    .promo__text {
      display: none;
    }
  }
  .header.is-scrolled {
    padding-block: 10px;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border-color: var(--line);
  }
  /* Reading progress: a thin gradient line across the top. */
  .progress {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--grad-btn);
    transform-origin: left;
    transform: scaleX(var(--p, 0));
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .logo__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--text);
    color: var(--bg);
    font-weight: 700;
    font-size: 15px;
    white-space: nowrap;
    letter-spacing: -0.04em;
    transition: transform 0.4s var(--ease-spring);
  }
  .logo__mark span {
    color: var(--accent);
  }
  .logo:hover .logo__mark {
    transform: rotate(-8deg) scale(1.05);
  }
  .logo__text {
    font-size: 14px;
    font-weight: 500;
  }
  .logo__dim {
    color: var(--text-faint);
  }

  .nav__list {
    display: flex;
    gap: 4px;
    list-style: none;
    padding: 5px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-elev) 70%, transparent);
  }
  .nav__link {
    display: block;
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 14.5px;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s, background-color 0.2s;
  }
  .nav__link:hover,
  .nav__link.is-active {
    color: var(--text);
    background: var(--bg-elev-2);
  }

  .header__actions {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    height: 40px;
    min-width: 40px;
    padding: 0 10px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--bg-elev);
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.2s, transform 0.3s var(--ease-spring);
  }
  .icon-btn:hover {
    border-color: var(--line-strong);
  }
  .icon-btn svg {
    width: 18px;
    height: 18px;
  }
  .bp-btn[aria-pressed='true'] {
    background: #4cc2ff;
    border-color: #4cc2ff;
    color: #04121f;
  }
  .kbd-btn {
    display: inline-flex;
    gap: 8px;
    font-size: 13px;
    color: var(--text-muted);
  }
  .kbd-btn > span:first-child {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 5px;
    background: var(--bg-elev-2);
    border: 1px solid var(--line-strong);
    color: var(--accent);
    font-weight: 700;
  }
  :global([data-theme='dark']) .i-sun,
  :global([data-theme='light']) .i-moon {
    display: none;
  }

  .burger {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }
  .burger span {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.3s var(--ease-out);
  }
  .burger[aria-expanded='true'] span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .burger[aria-expanded='true'] span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* Always-visible freelance call to action: brand gradient, a light sweep and a live "available" dot. */
  .hire-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 18px 0 14px;
    border-radius: 999px;
    background: var(--grad-btn);
    color: #fff;
    font-size: 14.5px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 8px 24px -8px var(--grad-glow), inset 0 1px 0 rgb(255 255 255 / 0.25);
    overflow: hidden;
    isolation: isolate;
    transition: transform 0.3s var(--ease-spring), box-shadow 0.3s;
  }
  .hire-btn::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(110deg, transparent 30%, rgb(255 255 255 / 0.35) 50%, transparent 70%);
    transform: translateX(-120%);
    animation: hire-sweep 4s 1.5s infinite;
  }
  .hire-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 30px -8px var(--grad-glow), inset 0 1px 0 rgb(255 255 255 / 0.25);
  }
  .hire-btn__dot {
    background: #5dffb5;
  }
  @keyframes hire-sweep {
    30%,
    100% {
      transform: translateX(120%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hire-btn::after {
      animation: none;
    }
  }
  /* Make room for the Hire me button before the nav collapses into the burger menu. */
  @media (max-width: 1360px) {
    .kbd-btn__label {
      display: none;
    }
  }
  @media (max-width: 1240px) {
    .logo__text,
    .bp-btn {
      display: none;
    }
  }
  @media (max-width: 420px) {
    .hire-btn {
      padding: 0 14px 0 12px;
      font-size: 13.5px;
    }
    .bp-btn {
      display: none;
    }
  }

  @media (max-width: 1080px) {
    .kbd-btn__label,
    .logo__text {
      display: none;
    }
    .burger {
      display: inline-flex;
    }
    .nav__list {
      position: fixed;
      inset: 68px 16px auto;
      flex-direction: column;
      gap: 2px;
      padding: 10px;
      border-radius: var(--radius-lg);
      background: var(--bg-elev);
      box-shadow: var(--shadow);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px) scale(0.98);
      transform-origin: top right;
      transition: opacity 0.25s, transform 0.35s var(--ease-out), visibility 0.25s;
    }
    .header:not(.is-scrolled) .nav__list {
      top: 116px;
    }
    .nav__list.is-open {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
    .nav__link {
      padding: 14px 16px;
      font-size: 17px;
      border-radius: var(--radius);
    }
  }
</style>

<script>
  let cleanup: AbortController | undefined;

  function initHeader() {
    cleanup?.abort();
    cleanup = new AbortController();
    const { signal } = cleanup;

    const header = document.querySelector<HTMLElement>('[data-header]');
    const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
    const list = document.getElementById('nav-list');
    const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    if (!header || !burger || !list || !themeBtn) return;

    const progress = header.querySelector<HTMLElement>('[data-progress]');
    const onScroll = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 20);
      const max = document.documentElement.scrollHeight - innerHeight;
      progress?.style.setProperty('--p', String(max > 0 ? Math.min(1, scrollY / max) : 0));
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true, signal });

    const setMenu = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      list.classList.toggle('is-open', open);
    };
    burger.addEventListener('click', () => setMenu(burger.getAttribute('aria-expanded') !== 'true'));
    list.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));

    themeBtn.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      const swap = () => {
        root.dataset.theme = next;
      };
      try {
        localStorage.setItem('theme', next);
      } catch {}
      // Use a view transition for a smooth theme change where supported.
      if ('startViewTransition' in document && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        (document as any).startViewTransition(swap);
      } else {
        swap();
      }
    });

    // Highlight the nav link of the section in view (home page only).
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
    const path = location.pathname;
    links.forEach((l) => {
      const href = l.getAttribute('href') ?? '';
      l.classList.toggle('is-active', !href.includes('#') && path.startsWith(href));
    });
    const sections = links
      .map((l) => l.getAttribute('href') ?? '')
      .filter((h) => h.startsWith('/#'))
      .map((h) => document.getElementById(h.slice(2)))
      .filter((el): el is HTMLElement => !!el);
    if (!sections.length) return;
    const spy = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((l) => l.classList.toggle('is-active', l.getAttribute('href') === `/#${e.target.id}`));
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => spy.observe(s));
    signal.addEventListener('abort', () => spy.disconnect());
  }
  document.addEventListener('astro:page-load', initHeader);
</script>
