---
import { PROFILE } from '@/data/profile';
const year = new Date().getFullYear();
---

<footer class="footer" data-bp="Footer.astro">
  <div class="container footer__inner">
    <p class="mono footer__code">
      <span class="c-fn">wp_footer</span>(); <span class="c-comment">// © {year} {PROFILE.name}</span>
    </p>
    <ul class="footer__links">
      <li><a href={`mailto:${PROFILE.email}`}>Email</a></li>
      <li><a href={PROFILE.links.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
      <li><a href={PROFILE.links.github} target="_blank" rel="noopener">GitHub</a></li>
      <li><a href={PROFILE.links.wporg} target="_blank" rel="noopener">WordPress.org</a></li>
    </ul>
    <p class="mono footer__built">
      Built with Astro · Press <kbd>/</kbd> to jump anywhere · Press <kbd>`</kbd> or
      <a href="#terminal" data-term-open>open the terminal</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: 40px;
  }
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
  }
  .footer__code {
    font-size: 13.5px;
    color: var(--text-muted);
  }
  .c-fn {
    color: var(--accent);
  }
  .c-comment {
    color: var(--text-faint);
  }
  .footer__links {
    display: flex;
    gap: 20px;
    list-style: none;
  }
  .footer__links a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 15px;
    transition: color 0.2s;
  }
  .footer__links a:hover {
    color: var(--accent);
  }
  .footer__built {
    width: 100%;
    font-size: 12px;
    color: var(--text-faint);
  }
  .footer__built a {
    color: var(--accent);
  }
  kbd {
    padding: 1px 6px;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    font-family: inherit;
  }
</style>
