---
// Freelance services as WordPress "Add Plugins" cards. `detailed` swaps in the longer,
// search-friendly heading and text used on the /hire/ landing page.
import { PROFILE, FREELANCE } from '@/data/profile';

interface Props {
  detailed?: boolean;
  level?: 'h3' | 'h4';
}
const { detailed = false, level: Title = 'h4' } = Astro.props;
---

<ul class:list={['plugins', { 'plugins--detailed': detailed }]}>
  {
    FREELANCE.services.map((s, i) => (
      <li class="plugin" id={detailed ? s.slug : undefined} data-reveal style={`--d:${i % 3}`}>
        <div class="plugin__top">
          <span class="plugin__icon" aria-hidden="true">
            {s.icon}
          </span>
          <div>
            <Title class="plugin__title">{detailed ? s.heading : s.title}</Title>
            <p class="plugin__by">
              By <span>{PROFILE.firstName}</span>
            </p>
          </div>
        </div>
        <p class="plugin__text">{detailed ? s.detail : s.text}</p>
        <div class="plugin__foot mono">
          <code>wp plugin install {s.slug}</code>
          <span class="plugin__status">
            <span class="live-dot" />
            Active
          </span>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .plugins {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 16px;
    margin-top: 20px;
  }
  .plugins--detailed {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
  }
  .plugin {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    scroll-margin-top: 110px;
    transition: transform 0.4s var(--ease-out), border-color 0.3s, box-shadow 0.4s;
  }
  .plugin:hover {
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
    box-shadow: var(--shadow);
  }
  .plugin__top {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .plugin__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--accent-soft);
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
    font-size: 25px;
    transition: transform 0.5s var(--ease-spring);
  }
  .plugin:hover .plugin__icon {
    transform: scale(1.12) rotate(-8deg);
  }
  .plugin__title {
    font-size: 19px;
    line-height: 1.25;
  }
  .plugin__by {
    margin-top: 2px;
    font-size: 13px;
    color: var(--text-faint);
  }
  .plugin__by span {
    color: var(--accent);
  }
  .plugin__text {
    flex: 1;
    font-size: 15px;
    color: var(--text-muted);
  }
  .plugin__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 11.5px;
  }
  .plugin__foot code {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text-faint);
  }
  .plugin__status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    padding: 3px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ok) 12%, transparent);
    color: var(--ok);
  }
</style>
