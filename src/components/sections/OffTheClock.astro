---
import Block from '@/components/ui/Block.astro';
import { PROFILE, INTERESTS } from '@/data/profile';
import { PEAKS, WELCOMES, POSTCARDS } from '@/data/kumaon';

// Peak positions on the far ridge (SVG x/y in its 1440 × 320 space), west → east.
const peakXY = [
  [450, 60],
  [720, 30],
  [1060, 70],
];
---

<Block id="life" block="maneesh/pahadi" class="life">
  <!-- Layered Himalayan ridges. Each layer moves at a different speed on scroll (parallax). -->
  <div class="range" aria-hidden="true" data-range data-bp="Parallax · 3 SVG layers">
    <span class="range__sun"></span>
    <svg class="ridge ridge--far" style="--speed:0.18" viewBox="0 0 1440 320" preserveAspectRatio="none">
      <path d="M0 250 L120 170 L190 205 L300 90 L370 140 L450 60 L540 150 L620 110 L720 30 L800 120 L880 80 L980 160 L1060 70 L1150 140 L1230 100 L1320 170 L1440 120 L1440 320 L0 320Z"></path>
      <path class="snow" d="M430 78 L450 60 L472 82 L458 76 L448 88 L440 76Z M700 50 L720 30 L742 54 L728 48 L718 62 L710 48Z M1040 88 L1060 70 L1080 92 L1066 86 L1056 98 L1048 86Z"></path>
    </svg>
    <div class="ridge peaks" style="--speed:0.18">
      {
        PEAKS.map((p, i) => (
          <span class="peak mono" style={`left:${(peakXY[i][0] / 1440) * 100}%; top:${(peakXY[i][1] / 320) * 100}%`}>
            {p.name}
            <span class="peak__h"> · {p.height}</span>
          </span>
        ))
      }
    </div>
    <svg class="ridge ridge--mid" style="--speed:0.09" viewBox="0 0 1440 320" preserveAspectRatio="none">
      <path d="M0 270 L90 220 L200 250 L330 160 L430 220 L560 150 L680 230 L790 180 L900 240 L1030 170 L1150 230 L1270 190 L1440 240 L1440 320 L0 320Z"></path>
    </svg>
    <svg class="ridge ridge--near" style="--speed:0" viewBox="0 0 1440 320" preserveAspectRatio="none">
      <path d="M0 300 Q160 250 320 285 T640 270 T960 290 T1280 265 T1440 280 L1440 320 L0 320Z"></path>
    </svg>
  </div>

  <div class="life__head" data-reveal>
    <p class="life__eyebrow mono">// off the clock</p>
    <p class="greet">
      <span class="greet__hi" lang="hi">पैलाग</span>
      <span class="greet__line">
        <em>Pailaag!</em> That's how we greet with respect in Kumaon. And
        <span class="greet__word" data-welcome={JSON.stringify(WELCOMES)}>{WELCOMES[0]}</span> to you, wherever you're reading
        from.
      </span>
    </p>
    <h2 class="life__title" id="life-title">A Kumaoni Pahadi <em>at heart.</em></h2>
    <p class="life__lead">
      I'm from Kumaon, the eastern hills of Uttarakhand (Devbhoomi, the land of the gods), where on a clear morning you can
      see Nanda Devi from the ridges. The mountains taught me patience, stamina and to keep climbing when the path gets
      steep. I bring the same mindset to a stubborn bug or a slow query.
    </p>
  </div>

  <!-- Aipan-inspired band: white rice-paste motifs on red ochre. It "paints" itself in when scrolled into view. -->
  <div class="aipan" data-reveal aria-hidden="true" data-bp="Aipan · SVG pattern">
    <svg width="100%" height="64">
      <defs>
        <pattern id="aipan-tile" width="96" height="64" patternUnits="userSpaceOnUse">
          <rect width="96" height="64" style="fill: var(--ochre)"></rect>
          <g fill="none" style="stroke: var(--rice)" stroke-width="1.6" stroke-linecap="round">
            <path d="M0 6 H96 M0 58 H96"></path>
            <path d="M48 16 L66 32 L48 48 L30 32 Z"></path>
            <path d="M48 23 L58 32 L48 41 L38 32 Z"></path>
            <path d="M0 22 Q8 32 0 42 M96 22 Q88 32 96 42"></path>
            <path d="M14 32 Q20 24 26 32 Q20 40 14 32 M70 32 Q76 24 82 32 Q76 40 70 32"></path>
          </g>
          <g style="fill: var(--rice)">
            <circle cx="48" cy="32" r="2.2"></circle>
            <circle cx="20" cy="32" r="1.4"></circle>
            <circle cx="76" cy="32" r="1.4"></circle>
            <circle cx="6" cy="12" r="1.3"></circle><circle cx="18" cy="12" r="1.3"></circle><circle cx="30" cy="12" r="1.3"></circle>
            <circle cx="42" cy="12" r="1.3"></circle><circle cx="54" cy="12" r="1.3"></circle><circle cx="66" cy="12" r="1.3"></circle>
            <circle cx="78" cy="12" r="1.3"></circle><circle cx="90" cy="12" r="1.3"></circle>
            <circle cx="6" cy="52" r="1.3"></circle><circle cx="18" cy="52" r="1.3"></circle><circle cx="30" cy="52" r="1.3"></circle>
            <circle cx="42" cy="52" r="1.3"></circle><circle cx="54" cy="52" r="1.3"></circle><circle cx="66" cy="52" r="1.3"></circle>
            <circle cx="78" cy="52" r="1.3"></circle><circle cx="90" cy="52" r="1.3"></circle>
          </g>
        </pattern>
      </defs>
      <rect width="100%" height="64" fill="url(#aipan-tile)"></rect>
    </svg>
  </div>

  <div class="cards-head" data-reveal>
    <h3 class="cards-head__title">Postcards from Kumaon</h3>
    <p class="cards-head__hint mono">tap a card to flip it ↻ <span class="swipe-hint">· swipe for more →</span></p>
  </div>
  <ul class="postcards">
    {
      POSTCARDS.map((c, i) => (
        <li data-reveal style={`--d:${i % 4}`}>
          <button type="button" class="postcard" aria-pressed="false" data-postcard>
            <span class="postcard__face postcard__front">
              <span class="postcard__kind mono">{c.kind}</span>
              <span class="postcard__icon" aria-hidden="true">
                {c.icon}
              </span>
              <span class="postcard__hi" lang="hi">
                {c.hi}
              </span>
              <span class="postcard__name">{c.name}</span>
            </span>
            <span class="postcard__face postcard__back">
              <span class="postcard__name">{c.name}</span>
              <span class="postcard__text">{c.text}</span>
            </span>
          </button>
        </li>
      ))
    }
  </ul>

  <div class="cards-head cards-head--hobbies" data-reveal>
    <h3 class="cards-head__title">And on any given weekend</h3>
  </div>

  <ul class="life__grid">
    {
      INTERESTS.map((item, i) => (
        <li class="hobby" data-reveal style={`--d:${i}`}>
          <span class="hobby__icon" aria-hidden="true">
            {item.icon}
          </span>
          <h3 class="hobby__title">{item.title}</h3>
          <code class="hobby__code mono">{item.code}</code>
          <p class="hobby__text">{item.text}</p>
        </li>
      ))
    }
  </ul>
</Block>

<style>
  :global(#life .block__frame) {
    overflow: hidden;
    padding-top: 0;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius-lg) + 8px);
    background: linear-gradient(180deg, var(--bg-elev) 0%, var(--bg) 70%);
  }
  :global(#life .block__label) {
    top: 16px;
    left: 20px;
    z-index: 2;
  }

  :global(#life) {
    --ochre: #9b2d25;
    --rice: #f6ecd9;
  }

  .range {
    position: relative;
    height: clamp(180px, 26vw, 320px);
    overflow: hidden;
  }
  .range__sun {
    position: absolute;
    top: 22%;
    right: 16%;
    width: clamp(46px, 6vw, 80px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--hot);
    box-shadow: 0 0 80px 20px color-mix(in srgb, var(--hot) 35%, transparent);
    opacity: 0.85;
  }
  /* In dark mode the sun becomes a moon. */
  :global([data-theme='dark']) .range__sun {
    background: #e8eaf0;
    box-shadow: 0 0 60px 10px rgb(232 234 240 / 0.18);
  }
  .ridge {
    position: absolute;
    left: -5%;
    bottom: 0;
    width: 110%;
    max-width: none;
    height: 100%;
    transform: translate3d(0, calc(var(--scroll, 0) * var(--speed) * 1px), 0);
    will-change: transform;
  }
  .ridge--far path {
    fill: color-mix(in srgb, var(--accent) 22%, var(--bg-elev));
  }
  .ridge--far .snow {
    fill: color-mix(in srgb, #fff 80%, var(--accent));
    opacity: 0.8;
  }
  .ridge--mid path {
    fill: color-mix(in srgb, var(--accent) 12%, var(--bg-elev-2));
  }
  .ridge--near path {
    fill: var(--bg);
  }

  .peaks {
    pointer-events: none;
  }
  .peak {
    position: absolute;
    transform: translate(12px, -30%);
    padding: 2px 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-elev) 80%, transparent);
    border: 1px solid var(--line);
    font-size: 10.5px;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .peak::before {
    content: '▲ ';
    color: var(--accent);
    font-size: 8px;
  }

  .greet {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 18px;
    margin-top: 14px;
  }
  .greet__hi {
    font-family: 'Tiro Devanagari Hindi', serif;
    font-size: clamp(44px, 7vw, 76px);
    line-height: 1.1;
    color: var(--ochre);
  }
  :global([data-theme='dark']) .greet__hi {
    color: #e0705f;
  }
  .greet__line {
    max-width: 440px;
    font-size: 15px;
    color: var(--text-muted);
  }
  .greet__line em {
    font-style: normal;
    font-weight: 600;
    color: var(--text);
  }
  .greet__word {
    display: inline-block;
    font-weight: 600;
    color: var(--accent);
    transition: opacity 0.3s, transform 0.3s var(--ease-out);
  }
  .greet__word.is-out {
    opacity: 0;
    transform: translateY(-8px);
  }

  .life__head {
    position: relative;
    max-width: 720px;
    padding: 8px clamp(20px, 5vw, 56px) 0;
    margin-top: -40px;
  }
  .life__eyebrow {
    font-size: 13px;
    color: var(--accent);
  }
  .life__title {
    margin-top: 12px;
    font-size: clamp(36px, 6vw, 68px);
  }
  .life__title em {
    font-style: normal;
    color: var(--text-faint);
  }
  .life__lead {
    margin-top: 18px;
    font-size: clamp(17px, 1.6vw, 19px);
    color: var(--text-muted);
  }

  .aipan {
    margin: clamp(32px, 5vw, 48px) 0 0;
    line-height: 0;
  }
  /* The clip sits on the SVG, not the observed wrapper: a clipped element never counts as "in view". */
  .aipan svg {
    display: block;
    width: 100%;
    clip-path: inset(0 100% 0 0);
    transition: clip-path 2.2s cubic-bezier(0.65, 0, 0.35, 1) 0.3s;
  }
  .aipan.is-visible svg {
    clip-path: inset(0 0 0 0);
  }

  .cards-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 16px;
    padding: clamp(32px, 5vw, 48px) clamp(20px, 5vw, 56px) 0;
  }
  .cards-head__title {
    font-size: clamp(22px, 2.6vw, 30px);
  }
  .cards-head__hint {
    font-size: 12px;
    color: var(--text-faint);
  }
  .swipe-hint {
    display: none;
  }
  @media (max-width: 600px) {
    .swipe-hint {
      display: inline;
    }
  }

  .postcards {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr));
    gap: 16px;
    padding: 20px clamp(20px, 5vw, 56px) 0;
  }
  .postcard {
    position: relative;
    display: block;
    width: 100%;
    height: 260px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    perspective: 1000px;
  }
  /* Phones: a swipeable row of postcards instead of a long stack. */
  @media (max-width: 600px) {
    .postcards {
      grid-auto-flow: column;
      grid-auto-columns: 74%;
      grid-template-columns: none;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 20px;
      padding-bottom: 6px;
      scrollbar-width: none;
    }
    .postcards::-webkit-scrollbar {
      display: none;
    }
    .postcards li {
      scroll-snap-align: start;
    }
  }
  .postcard__face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transition: transform 0.7s var(--ease-out);
  }
  .postcard__front {
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 20px;
    background: var(--ochre);
    color: var(--rice);
    /* A dotted rice-paste frame, like an Aipan border. */
    box-shadow:
      inset 0 0 0 8px var(--ochre),
      inset 0 0 0 10px var(--rice),
      inset 0 0 0 14px var(--ochre);
  }
  .postcard__front::before {
    content: '';
    position: absolute;
    inset: 20px;
    border: 2px dotted color-mix(in srgb, var(--rice) 70%, transparent);
    border-radius: 10px;
    pointer-events: none;
  }
  .postcard__kind {
    position: absolute;
    top: 28px;
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.8;
  }
  .postcard__icon {
    font-size: 40px;
    transition: transform 0.5s var(--ease-spring);
  }
  .postcard:hover .postcard__icon {
    transform: scale(1.15) rotate(-8deg);
  }
  .postcard__hi {
    font-family: 'Tiro Devanagari Hindi', serif;
    font-size: 30px;
    line-height: 1.3;
  }
  .postcard__front .postcard__name {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    opacity: 0.85;
  }
  .postcard__back {
    gap: 12px;
    padding: 24px;
    border: 1px solid var(--line-strong);
    background: var(--bg-elev);
    transform: rotateY(180deg);
  }
  .postcard__back .postcard__name {
    font-size: 20px;
    font-weight: 600;
    color: var(--ochre);
  }
  :global([data-theme='dark']) .postcard__back .postcard__name {
    color: #e0705f;
  }
  .postcard__text {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--text-muted);
  }
  .postcard[aria-pressed='true'] .postcard__front {
    transform: rotateY(-180deg);
  }
  .postcard[aria-pressed='true'] .postcard__back {
    transform: rotateY(0);
  }

  .life__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 16px;
    padding: 20px clamp(20px, 5vw, 56px) clamp(32px, 5vw, 56px);
  }
  .hobby {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--bg-elev) 80%, transparent);
    transition: transform 0.4s var(--ease-out), border-color 0.3s;
  }
  .hobby:hover {
    transform: translateY(-6px) rotate(-0.6deg);
    border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
  }
  .hobby__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--bg-elev-2);
    font-size: 26px;
    transition: transform 0.5s var(--ease-spring);
  }
  .hobby:hover .hobby__icon {
    transform: scale(1.15) rotate(-10deg);
  }
  .hobby__title {
    margin-top: 6px;
    font-size: 21px;
  }
  .hobby__code {
    font-size: 12px;
    color: var(--accent);
    word-break: break-word;
  }
  @media (max-width: 600px) {
    .peak {
      font-size: 9.5px;
      padding: 1px 6px;
      transform: translate(-50%, 14px);
    }
    .peak:last-child {
      transform: translate(-85%, 14px);
    }
    /* The decorative block tag would cover the Trishul label on small screens. */
    :global(#life .block__label) {
      display: none;
    }
    .peak__h {
      display: none;
    }
  }

  .hobby__text {
    font-size: 15px;
    color: var(--text-muted);
  }
</style>

<script>
  let stopParallax: AbortController | undefined;

  function initParallax() {
    stopParallax?.abort();
    const range = document.querySelector<HTMLElement>('[data-range]');
    if (!range || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    stopParallax = new AbortController();
    let ticking = false;
    const update = () => {
      // Distance of the range's centre from the viewport's centre (clamped); far ridges shift more than near ones.
      const r = range.getBoundingClientRect();
      const offset = Math.max(-400, Math.min(400, r.top + r.height / 2 - innerHeight / 2));
      range.style.setProperty('--scroll', String(offset));
      ticking = false;
    };
    update();
    addEventListener(
      'scroll',
      () => {
        if (!ticking) (ticking = true), requestAnimationFrame(update);
      },
      { passive: true, signal: stopParallax.signal },
    );
  }
  document.addEventListener('astro:page-load', initParallax);

  let welcomeTimer: number | undefined;
  function initKumaon() {
    document.querySelectorAll<HTMLButtonElement>('[data-postcard]').forEach((card) =>
      card.addEventListener('click', () => card.setAttribute('aria-pressed', String(card.getAttribute('aria-pressed') !== 'true'))),
    );

    // Rotate "hello" through the languages of the teams I've worked with.
    window.clearInterval(welcomeTimer);
    const word = document.querySelector<HTMLElement>('[data-welcome]');
    if (!word || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const words: string[] = JSON.parse(word.dataset.welcome ?? '[]');
    let i = 0;
    welcomeTimer = window.setInterval(() => {
      word.classList.add('is-out');
      setTimeout(() => {
        i = (i + 1) % words.length;
        word.textContent = words[i];
        word.classList.remove('is-out');
      }, 300);
    }, 2000);
  }
  document.addEventListener('astro:page-load', initKumaon);
</script>
