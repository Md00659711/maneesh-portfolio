---
import { PROFILE, HOOKS } from '@/data/profile';
import { MARQUEE } from '@/data/skills';

// Split the name into letters at build time so each one can animate in with a stagger.
const nameLines = ['Maneesh', 'Singh Dhanik.'];
let letterIndex = 0;
---

<section class="hero" id="top" data-hero data-bp="Hero.astro · <section>">
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__grid"></div>
    <div class="hero__glow"></div>
  </div>

  <div class="container hero__inner">
    <div class="hero__copy">
      {
        PROFILE.available && (
          <p class="hero__status mono">
            <span class="pulse" aria-hidden="true" />
            Open to new roles &amp; freelance work
          </p>
        )
      }

      <h1 class="hero__name" data-name>
        <span class="visually-hidden">{PROFILE.name}, {PROFILE.role} and {PROFILE.speciality}</span>
        {
          nameLines.map((line) => (
            <span class="hero__line" aria-hidden="true">
              {line.split(' ').map((word) => (
                <span class="word">
                  {[...word].map((ch) => (
                    <span class="ch" style={`--i:${letterIndex++}`}>
                      {ch}
                    </span>
                  ))}
                </span>
              ))}
            </span>
          ))
        }
      </h1>

      <p class="hero__role">
        <strong>{PROFILE.role}</strong> &amp; {PROFILE.speciality}. I engineer fast, scalable platforms for real traffic, with an AI-assisted, performance-first workflow.
      </p>

      <div class="hero__cta">
        <a href="/projects/" class="btn btn--primary" data-magnetic>
          See my work
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
        <a href="/#contact" class="btn" data-magnetic>Get in touch</a>
      </div>
      <p class="hero__hint mono">
        psst… <button type="button" data-blueprint-toggle>see how this page is engineered ⌗</button>
        <span class="hero__keys">or press <kbd>B</kbd> · <kbd>/</kbd> · <kbd>`</kbd></span>
      </p>
    </div>

    <div class="editor" aria-label="Code sample" role="img" data-bp="CodeEditor · typewriter">
      <div class="editor__bar">
        <span class="editor__dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="mono editor__file">functions.php</span>
      </div>
      <pre class="editor__code mono" aria-hidden="true"><span class="ln">1</span><span class="c-tag">&lt;?php</span>
<span class="ln">2</span><span class="c-com">/**</span>
<span class="ln">3</span><span class="c-com"> * Plugin Name: Maneesh</span>
<span class="ln">4</span><span class="c-com"> * Version:     6.0 (years) + AI</span>
<span class="ln">5</span><span class="c-com"> * Based in:    {PROFILE.location.split(',')[0]}</span>
<span class="ln">6</span><span class="c-com"> * Roots:       Kumaon ⛰</span>
<span class="ln">7</span><span class="c-com"> */</span>
<span class="ln">8</span>
<span class="ln">9</span><span data-typer data-lines={JSON.stringify(HOOKS)}></span><span class="caret"></span></pre>
      <div class="editor__foot mono">
        <span><span class="ok-dot"></span> PHP 8.3</span>
        <span>UTF-8</span>
        <span>WordPress ✓</span>
      </div>
    </div>
  </div>

  <div class="marquee" aria-hidden="true">
    <div class="marquee__track mono">
      {
        [...MARQUEE, ...MARQUEE].map((t) => (
          <span>
            {t}
            <i>✦</i>
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 120px;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, #000 30%, transparent 75%);
    opacity: 0.55;
  }
  .hero__glow {
    position: absolute;
    width: 560px;
    height: 560px;
    left: var(--mx, 60%);
    top: var(--my, 35%);
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(circle, var(--accent-soft), transparent 65%);
    filter: blur(20px);
    transition: left 0.6s var(--ease-out), top 0.6s var(--ease-out);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--bg-elev);
    font-size: 12.5px;
    color: var(--text-muted);
    margin-bottom: 28px;
    animation: fade-up 0.8s var(--ease-out) both;
  }
  .pulse {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ok);
  }
  .pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--ok);
    animation: ping 1.8s var(--ease-out) infinite;
  }

  .hero__name {
    position: relative; /* the letters' offsets are measured from here */
    font-size: clamp(46px, 8vw, 104px);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.95;
  }
  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }
  /* Words never break mid-letter; lines can still wrap between words. */
  .word {
    display: inline-block;
    white-space: nowrap;
    margin-right: 0.22em;
  }
  .ch {
    display: inline-block;
    animation: letter-in 0.9s var(--ease-out) both;
    animation-delay: calc(var(--i) * 32ms + 150ms);
  }

  /* Gradient name. Gradient text can't pass through animated letters, so each letter
     paints its own slice of one shared gradient (--cx/--cy = its offset, set by script). */
  @property --drift {
    syntax: '<length>';
    inherits: true;
    initial-value: 0px;
  }
  .hero__name.has-grad {
    animation: name-drift 14s ease-in-out infinite alternate;
  }
  .has-grad .ch {
    background-image: var(--grad-text);
    background-size: calc(var(--nw) * 2) var(--nh);
    background-position: calc(var(--drift) - var(--cx)) calc(var(--cy) * -1);
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    /* Room for descenders (g) so they aren't cut off by the clip. */
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }
  @keyframes name-drift {
    to {
      --drift: calc(var(--nw) * -1);
    }
  }

  .hero__role {
    max-width: 520px;
    margin-top: 28px;
    font-size: clamp(17px, 1.6vw, 20px);
    color: var(--text-muted);
    animation: fade-up 0.9s 0.6s var(--ease-out) both;
  }
  .hero__role strong {
    color: var(--text);
    font-weight: 600;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
    animation: fade-up 0.9s 0.75s var(--ease-out) both;
  }

  .hero__hint {
    margin-top: 22px;
    font-size: 12.5px;
    color: var(--text-faint);
    animation: fade-up 0.9s 0.9s var(--ease-out) both;
  }
  .hero__hint button {
    padding: 0;
    border: 0;
    border-bottom: 1px dashed currentColor;
    background: none;
    color: var(--accent);
    font: inherit;
    cursor: pointer;
  }
  .hero__keys kbd {
    padding: 0 5px;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    font-family: inherit;
  }
  @media (pointer: coarse) {
    .hero__keys {
      display: none;
    }
  }

  /* Code editor card */
  .editor {
    translate: 0 var(--py, 0);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--bg-elev) 88%, transparent);
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow);
    overflow: hidden;
    animation: float-in 1.1s 0.4s var(--ease-out) both;
    transform: perspective(1200px) rotateY(-6deg) rotateX(3deg);
    transition: transform 0.6s var(--ease-out);
  }
  .editor:hover {
    transform: perspective(1200px) rotateY(0) rotateX(0);
  }
  .editor__bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
  }
  .editor__dots {
    display: flex;
    gap: 6px;
  }
  .editor__dots i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .editor__dots i:first-child {
    background: #ff5f57;
  }
  .editor__dots i:nth-child(2) {
    background: #febc2e;
  }
  .editor__dots i:nth-child(3) {
    background: #28c840;
  }
  .editor__file {
    font-size: 12px;
    color: var(--text-muted);
  }
  .editor__code {
    margin: 0;
    padding: 20px 18px 24px;
    font-size: clamp(11.5px, 1.1vw, 13.5px);
    line-height: 1.85;
    color: var(--text);
    white-space: pre-wrap;
    word-break: break-word;
    min-height: 260px;
  }
  .ln {
    display: inline-block;
    width: 22px;
    margin-right: 14px;
    color: var(--text-faint);
    user-select: none;
    text-align: right;
  }
  .c-tag {
    color: var(--hot);
  }
  .c-com {
    color: var(--text-faint);
  }
  .editor__code :global(.t-fn) {
    color: var(--accent);
  }
  .editor__code :global(.t-str) {
    color: var(--ok);
  }
  .caret {
    display: inline-block;
    width: 8px;
    height: 1.1em;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: blink 1s steps(1) infinite;
  }
  .editor__foot {
    display: flex;
    gap: 18px;
    padding: 9px 16px;
    border-top: 1px solid var(--line);
    font-size: 11px;
    color: var(--text-faint);
  }
  .ok-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ok);
    margin-right: 4px;
  }

  /* Marquee */
  .marquee {
    margin-top: clamp(56px, 9vw, 110px);
    border-block: 1px solid var(--line);
    padding-block: 18px;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 40s linear infinite;
  }
  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }
  .marquee span {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    padding-right: 28px;
    font-size: 15px;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .marquee i {
    color: var(--accent);
    font-style: normal;
    font-size: 11px;
  }

  @keyframes letter-in {
    from {
      opacity: 0;
      transform: translateY(105%) rotate(6deg);
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  @keyframes float-in {
    from {
      opacity: 0;
      transform: perspective(1200px) rotateY(-18deg) rotateX(8deg) translateY(40px);
    }
  }
  @keyframes ping {
    75%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 960px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .editor {
      transform: none;
    }
    .editor__code {
      min-height: 0;
    }
  }
</style>

<script>
  let stop: AbortController | undefined;

  // Wrap PHP-ish tokens in spans for simple syntax colouring.
  const highlight = (s: string) =>
    s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/('[^']*'?)/g, '<span class="t-str">$1</span>')
      .replace(/^(\w+)/, '<span class="t-fn">$1</span>');

  // Line each letter's gradient slice up with its position in the name.
  function paintName() {
    const name = document.querySelector<HTMLElement>('[data-name]');
    if (!name || !CSS.supports('background-clip', 'text') && !CSS.supports('-webkit-background-clip', 'text')) return;
    const letters = [...name.querySelectorAll<HTMLElement>('.ch')];
    let width = 0;
    let height = 0;
    for (const ch of letters) {
      // offsetLeft/Top ignore transforms, so this is correct even mid-animation.
      ch.style.setProperty('--cx', `${ch.offsetLeft}px`);
      ch.style.setProperty('--cy', `${ch.offsetTop}px`);
      width = Math.max(width, ch.offsetLeft + ch.offsetWidth);
      height = Math.max(height, ch.offsetTop + ch.offsetHeight);
    }
    name.style.setProperty('--nw', `${width}px`);
    name.style.setProperty('--nh', `${height}px`);
    name.classList.add('has-grad');
  }

  function initHero() {
    stop?.abort();
    paintName();
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const typer = document.querySelector<HTMLElement>('[data-typer]');
    if (!hero || !typer) return;
    stop = new AbortController();
    const { signal } = stop;
    addEventListener('resize', paintName, { signal });
    document.fonts?.ready.then(paintName);
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Typewriter: types each hook, pauses, deletes, moves to the next one.
    const lines: string[] = JSON.parse(typer.dataset.lines ?? '[]');
    if (reduced) {
      typer.innerHTML = highlight(lines[0] ?? '');
    } else {
      let line = 0;
      let pos = 0;
      let deleting = false;
      const tick = () => {
        if (signal.aborted) return;
        const text = lines[line];
        pos += deleting ? -1 : 1;
        typer.innerHTML = highlight(text.slice(0, pos));
        let delay = deleting ? 18 : 42 + Math.random() * 40;
        if (!deleting && pos === text.length) {
          deleting = true;
          delay = 2200;
        } else if (deleting && pos === 0) {
          deleting = false;
          line = (line + 1) % lines.length;
          delay = 400;
        }
        setTimeout(tick, delay);
      };
      setTimeout(tick, 1200);
    }

    // Spotlight follows the cursor (desktop only).
    if (!reduced && matchMedia('(pointer: fine)').matches) {
      hero.addEventListener(
        'pointermove',
        (e) => {
          const r = hero.getBoundingClientRect();
          hero.style.setProperty('--mx', `${((e.clientX - r.left) / r.width) * 100}%`);
          hero.style.setProperty('--my', `${((e.clientY - r.top) / r.height) * 100}%`);
        },
        { signal },
      );

      // Magnetic buttons: they lean slightly toward the cursor.
      document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
        el.addEventListener(
          'pointermove',
          (e) => {
            const r = el.getBoundingClientRect();
            const x = (e.clientX - r.left - r.width / 2) * 0.25;
            const y = (e.clientY - r.top - r.height / 2) * 0.35;
            el.style.transform = `translate(${x}px, ${y}px)`;
          },
          { signal },
        );
        el.addEventListener('pointerleave', () => (el.style.transform = ''), { signal });
      });
    }
  }
  document.addEventListener('astro:page-load', initHero);
</script>
