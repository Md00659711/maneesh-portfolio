---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import { PROFILE, TEAMS, INTERESTS } from '@/data/profile';
import { SKILL_GROUPS } from '@/data/skills';
import { EXPERIENCE, EDUCATION } from '@/data/experience';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const fmt = (ym: string | null) =>
  ym ? new Date(`${ym}-01T00:00:00Z`).toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' }) : 'Present';
const countries = TEAMS.filter((t) => !t.home).map((t) => t.country);
const strip = (url: string) => url.replace(/^https?:\/\/(www\.|in\.)?/, '').replace(/\/$/, '');
---

<BaseLayout
  title="CV / Résumé"
  description={`CV of ${PROFILE.name}, ${PROFILE.role} and ${PROFILE.speciality} with 6+ years in PHP, Gutenberg, WooCommerce, React and large-scale WordPress. Download as PDF.`}
>
  <div class="cv-page container">
    <div class="cv-bar" data-no-print>
      <Breadcrumbs items={[{ label: 'CV', href: '/cv/' }]} />
      <button type="button" class="btn btn--primary" data-print>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"></path></svg>
        Download PDF
      </button>
    </div>

    <article class="cv" data-reveal>
      <header class="cv__head">
        <div>
          <h1>{PROFILE.name}</h1>
          <p class="cv__role">{PROFILE.role} &amp; {PROFILE.speciality} · {PROFILE.tagline}</p>
        </div>
        <ul class="cv__contact mono">
          <li>{PROFILE.location}</li>
          <li><a href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a></li>
          <li><a href={PROFILE.links.linkedin}>{strip(PROFILE.links.linkedin)}</a></li>
          <li><a href={PROFILE.links.github}>{strip(PROFILE.links.github)}</a></li>
          <li><a href={PROFILE.links.wporg}>{strip(PROFILE.links.wporg)}</a></li>
        </ul>
      </header>

      <section class="cv__sec">
        <h2>Summary</h2>
        {PROFILE.summary.map((p) => <p>{p}</p>)}
        <p>Worked with distributed teams in {countries.join(', ')}, using Agile and Jira.</p>
      </section>

      <section class="cv__sec">
        <h2>Skills</h2>
        <dl class="cv__skills">
          {
            SKILL_GROUPS.map((g) => (
              <div>
                <dt>{g.name}</dt>
                <dd>{g.items.join(', ')}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="cv__sec">
        <h2>Experience</h2>
        {
          EXPERIENCE.map((job) => (
            <div class="cv__job">
              <div class="cv__job-head">
                <h3>
                  {job.role}, {job.company}<span>, {job.location}</span>
                </h3>
                <p class="mono">
                  {fmt(job.start)} – {fmt(job.end)}
                </p>
              </div>
              <ul>
                {job.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>

      <section class="cv__sec">
        <h2>Selected projects</h2>
        {
          projects.map((p) => (
            <div class="cv__job">
              <div class="cv__job-head">
                <h3>
                  <a href={`/projects/${p.id}/`}>{p.data.title}</a>{p.data.url && <span>, {strip(p.data.url)}</span>}
                </h3>
                <p class="mono">{p.data.year}</p>
              </div>
              <p>{p.data.summary}</p>
              <p class="cv__stack mono">{p.data.stack.join(' · ')}</p>
            </div>
          ))
        }
      </section>

      <section class="cv__sec cv__two">
        <div>
          <h2>Education &amp; certifications</h2>
          <ul class="cv__edu">
            {
              EDUCATION.map((e) => (
                <li>
                  <strong>{e.title}</strong>, {e.org}
                  {e.period && <span class="mono"> · {e.period}</span>}
                  {e.note && <em> · {e.note}</em>}
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h2>Outside work</h2>
          <p>
            A Kumaoni Pahadi from {PROFILE.roots}. {INTERESTS.map((i) => i.title).join(', ')}.
          </p>
        </div>
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  .cv-page {
    padding-top: 120px;
    padding-bottom: var(--section-space);
  }
  .cv-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
  }
  .cv {
    max-width: 900px;
    margin-inline: auto;
    padding: clamp(24px, 5vw, 64px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
    font-size: 15.5px;
    line-height: 1.55;
  }
  .cv a {
    color: var(--accent);
    text-decoration: none;
  }
  .cv__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 24px;
    border-bottom: 2px solid var(--text);
  }
  .cv__head h1 {
    font-size: clamp(30px, 5vw, 42px);
    letter-spacing: -0.03em;
  }
  .cv__role {
    margin-top: 6px;
    color: var(--text-muted);
  }
  .cv__contact {
    list-style: none;
    display: grid;
    gap: 2px;
    font-size: 12.5px;
    color: var(--text-muted);
    text-align: right;
  }
  .cv__sec {
    padding-block: 22px;
    border-bottom: 1px solid var(--line);
  }
  .cv__sec:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .cv__sec h2 {
    margin-bottom: 12px;
    font: 500 12px var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
  }
  .cv__sec > p + p {
    margin-top: 8px;
  }
  .cv__sec p {
    color: var(--text-muted);
  }
  .cv__skills {
    display: grid;
    gap: 6px;
    margin: 0;
  }
  .cv__skills div {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 12px;
  }
  .cv__skills dt {
    font-weight: 600;
  }
  .cv__skills dd {
    margin: 0;
    color: var(--text-muted);
  }
  .cv__job + .cv__job {
    margin-top: 18px;
  }
  .cv__job-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 16px;
    margin-bottom: 6px;
  }
  .cv__job h3 {
    font-size: 16.5px;
    letter-spacing: -0.01em;
  }
  .cv__job h3 span {
    color: var(--text-muted);
    font-weight: 400;
  }
  .cv__job-head p {
    font-size: 12.5px;
    color: var(--text-faint);
  }
  .cv__job ul {
    display: grid;
    gap: 4px;
    padding-left: 18px;
    color: var(--text-muted);
  }
  .cv__stack {
    margin-top: 6px;
    font-size: 12px;
  }
  .cv__two {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 28px;
  }
  .cv__edu {
    list-style: none;
    display: grid;
    gap: 6px;
    color: var(--text-muted);
  }
  .cv__edu strong {
    color: var(--text);
    font-weight: 600;
  }
  .cv__edu span {
    font-size: 12.5px;
  }

  @media (max-width: 640px) {
    .cv__contact {
      text-align: left;
    }
    .cv__skills div,
    .cv__two {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    .cv__two {
      gap: 22px;
    }
  }

  @media print {
    @page {
      size: A4;
      margin: 14mm;
    }
    .cv-page {
      padding: 0;
      max-width: none;
    }
    .cv {
      max-width: none;
      padding: 0;
      border: 0;
      font-size: 10pt;
    }
    .cv__sec {
      padding-block: 10pt;
    }
    .cv__job {
      break-inside: avoid;
    }
    .cv__skills div {
      grid-template-columns: 130px 1fr;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
  });
</script>
