---
// Freelance landing page: the page that should rank for "hire a WordPress developer" style searches.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Facts from '@/components/hire/Facts.astro';
import ServiceCards from '@/components/hire/ServiceCards.astro';
import SupportForum from '@/components/hire/SupportForum.astro';
import { PROFILE, STATS, FREELANCE } from '@/data/profile';

const mail = (subject: string) => `mailto:${PROFILE.email}?subject=${encodeURIComponent(subject)}`;
const pageUrl = new URL('/hire/', Astro.site).href;

// Service + FAQ structured data, so Google knows what is offered and can show the questions in results.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Freelance WordPress development and support',
  url: pageUrl,
  serviceType: FREELANCE.services.map((s) => s.heading),
  areaServed: FREELANCE.markets.map((m) => ({ '@type': 'Country', name: m.country })),
  offers: {
    '@type': 'Offer',
    priceSpecification: { '@type': 'UnitPriceSpecification', price: FREELANCE.rate, priceCurrency: 'USD', unitText: 'HOUR' },
  },
  provider: {
    '@type': 'Person',
    name: PROFILE.name,
    alternateName: PROFILE.alternateNames,
    jobTitle: 'Freelance WordPress Developer',
    email: `mailto:${PROFILE.email}`,
    url: Astro.site?.href,
    address: { '@type': 'PostalAddress', addressLocality: 'Noida', addressRegion: 'Uttar Pradesh', addressCountry: 'IN' },
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'WordPress services',
    itemListElement: FREELANCE.services.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.heading, description: s.detail },
    })),
  },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FREELANCE.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const proof = [
  { value: `${STATS[1].value}${STATS[1].suffix}`, text: STATS[1].label },
  { value: `${STATS[2].value}${STATS[2].suffix}`, text: STATS[2].label },
  { value: `${STATS[3].value}${STATS[3].suffix}`, text: STATS[3].label },
];
---

<BaseLayout
  title={`Hire a Freelance WordPress Developer from $${FREELANCE.rate}/hour`}
  description={`Hire a freelance WordPress developer for your US, UK, Australian or NZ business. ${FREELANCE.delivered}+ sites delivered, $${FREELANCE.rate}/hour, free speed check and estimate. Themes, plugins, WooCommerce, bug fixes.`}
  jsonLd={[serviceSchema, faqSchema]}
>
  <section class="section page">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Hire me', href: '/hire/' }]} />

      <header class="hero" data-reveal>
        <p class="hero__status mono"><span class="live-dot"></span> Available for freelance projects</p>
        <h1 class="hero__title">Hire a freelance <span>WordPress developer</span></h1>
        <p class="hero__lead">
          I'm {PROFILE.firstName}, a WordPress developer with 6+ years of experience and {FREELANCE.delivered}+ websites
          delivered, working with businesses in the US, UK, Australia and New Zealand. Custom themes, plugins, Gutenberg
          blocks, WordPress VIP, WooCommerce, speed optimisation, bug fixing and ongoing WordPress support, from one developer who owns the
          work end to end.
        </p>
        <ul class="hero__chips mono" aria-label="At a glance">
          <li class="hero__price"><strong>${FREELANCE.rate}</strong>/hour (USD)</li>
          <li>✓ Free consultation</li>
          <li>✓ Free estimate</li>
          <li>✓ 7 days free support</li>
          <li class="hero__flags" aria-label={`Clients in ${FREELANCE.markets.map((m) => m.country).join(', ')}`}>
            {FREELANCE.markets.map((m) => <span title={m.country}>{m.flag}</span>)}
          </li>
        </ul>
        <div class="hero__cta">
          <a href={mail('Free consultation')} class="btn btn--primary" data-magnetic>💬 Book a free consultation</a>
          <a href={mail('Freelance WordPress project')} class="btn" data-magnetic>Start a project →</a>
          <a href="/free-wordpress-speed-test/" class="btn" data-magnetic>⚡ Free speed test</a>
          <a href={mail('WordPress bug fix')} class="btn" data-magnetic>🐞 Fix a bug</a>
        </div>
      </header>

      <Facts />

      <section class="part" id="pricing" aria-labelledby="pricing-title">
        <p class="part__eyebrow mono">// pricing</p>
        <h2 class="part__title" id="pricing-title">Simple pricing: ${FREELANCE.rate}/hour, with free extras</h2>
        <p class="part__lead">
          Senior-level WordPress work at a rate that fits small businesses and agencies in the US, UK, Australia and New
          Zealand. Hourly for fixes and support, a fixed quote for bigger projects. No retainers, no lock-in.
        </p>
        <div class="pricing" data-reveal>
          <div class="price">
            <p class="price__tag mono">Hourly rate</p>
            <p class="price__value">${FREELANCE.rate}<span>/hour</span></p>
            <p class="price__note">USD · billed for actual time · bug fixes, changes and support</p>
            <a href={mail(`WordPress work at $${FREELANCE.rate}/hour`)} class="btn btn--primary" data-magnetic>Hire me →</a>
          </div>
          <ul class="offers">
            {
              FREELANCE.offers.map((o) => (
                <li>
                  <span class="offers__icon" aria-hidden="true">
                    {o.icon}
                  </span>
                  <div>
                    <h3 class="offers__title">
                      {o.title} <span class="offers__free mono">FREE</span>
                    </h3>
                    <p class="offers__text">{o.text}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="part" id="services" aria-labelledby="services-title">
        <p class="part__eyebrow mono">// services</p>
        <h2 class="part__title" id="services-title">WordPress development services</h2>
        <p class="part__lead">
          From a new custom website to a single urgent fix. Every service is built on clean, documented code that your
          next developer can pick up.
        </p>
        <ServiceCards detailed level="h3" />
      </section>

      <section class="part" id="problems" aria-labelledby="problems-title">
        <p class="part__eyebrow mono">// wp-content/debug.log</p>
        <h2 class="part__title" id="problems-title">Common WordPress problems I fix</h2>
        <p class="part__lead">
          Is your WordPress site down, broken or slow? These are the errors clients most often send me, and every one of
          them can be fixed.
        </p>
        <div class="log" data-reveal>
          <div class="log__bar mono">
            <span class="log__dots" aria-hidden="true"><i></i><i></i><i></i></span>
            debug.log
            <span class="log__count">{FREELANCE.problems.length} issues · 0 open</span>
          </div>
          <ul class="log__list mono">
            {
              FREELANCE.problems.map((p) => (
                <li>
                  <span class="log__error">
                    <b>[error]</b> {p.error}
                  </span>
                  <span class="log__fix">✓ {p.fix}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <p class="part__note">
          Site broken right now? <a href={mail('Urgent: WordPress site broken')}>Email me the error message</a> and a link
          to the site.
        </p>
      </section>

      <section class="part" id="why" aria-labelledby="why-title">
        <p class="part__eyebrow mono">// why hire me</p>
        <h2 class="part__title" id="why-title">Experience on sites much bigger than yours</h2>
        <p class="part__lead">
          Most of my work is on large, high-traffic WordPress platforms. That experience goes into every small site and
          every bug fix too. <a href="/projects/">See the case studies →</a>
        </p>
        <ul class="proof" data-reveal>
          {
            proof.map((p) => (
              <li>
                <span class="proof__value">{p.value}</span>
                <span class="proof__text">{p.text}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="part" id="clients" aria-labelledby="clients-title">
        <p class="part__eyebrow mono">// clients</p>
        <h2 class="part__title" id="clients-title">Why clients in the US, UK and New Zealand keep coming back</h2>
        <ul class="markets mono" data-reveal>
          {FREELANCE.markets.map((m) => (
            <li>
              <span aria-hidden="true">{m.flag}</span> {m.country}
            </li>
          ))}
        </ul>
        <ul class="trust">
          {
            FREELANCE.trust.map((t, i) => (
              <li class="trust__item" data-reveal style={`--d:${i}`}>
                <span class="trust__icon" aria-hidden="true">
                  {t.icon}
                </span>
                <h3 class="trust__title">{t.title}</h3>
                <p class="trust__text">{t.text}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="part" id="process" aria-labelledby="process-title">
        <p class="part__eyebrow mono">// how it works</p>
        <h2 class="part__title" id="process-title">How hiring a freelance WordPress developer works</h2>
        <ol class="steps">
          {
            FREELANCE.process.map((step, i) => (
              <li class="step" data-reveal style={`--d:${i}`}>
                <span class="step__num mono">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="step__title">{step.title}</h3>
                <p class="step__text">{step.text}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="part" id="faq" aria-label="Freelance WordPress FAQ">
        <SupportForum level="h2" />
      </section>

      <section class="final" id="start" data-reveal aria-labelledby="start-title">
        <p class="final__status mono"><span class="live-dot"></span> Taking new projects now</p>
        <h2 class="final__title" id="start-title">Have a WordPress project or a bug to fix?</h2>
        <p class="final__lead">
          Tell me what you need. You'll get a reply within a day and a free written estimate before any work starts. ${FREELANCE.rate}/hour, 7 days of free support included.
        </p>
        <div class="final__cta">
          <a href={mail('Freelance WordPress project')} class="btn btn--primary" data-magnetic>Hire me →</a>
          <a href="/free-wordpress-speed-test/" class="btn">⚡ Free speed test</a>
          <a href={PROFILE.links.linkedin} class="btn" target="_blank" rel="noopener">Message on LinkedIn ↗</a>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    padding-top: 140px;
  }
  a:not(.btn) {
    color: var(--accent);
  }

  .hero {
    max-width: 860px;
    margin-top: 24px;
  }
  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px;
    border: 1px solid color-mix(in srgb, var(--ok) 35%, var(--line));
    border-radius: 999px;
    background: color-mix(in srgb, var(--ok) 8%, transparent);
    font-size: 12.5px;
    color: var(--ok);
  }
  .hero__title {
    margin-top: 20px;
    font-size: clamp(40px, 7vw, 84px);
  }
  .hero__title span {
    background: var(--grad-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero__lead {
    margin-top: 22px;
    max-width: 720px;
    font-size: clamp(17px, 1.7vw, 20px);
    color: var(--text-muted);
  }
  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
    padding: 0;
    list-style: none;
    font-size: 13px;
  }
  .hero__chips li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-elev);
    color: var(--text-muted);
  }
  .hero__price {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--line)) !important;
    background: var(--accent-soft) !important;
    color: var(--text) !important;
  }
  .hero__price strong {
    font-size: 15px;
    color: var(--accent);
  }
  .hero__flags {
    font-size: 17px;
    letter-spacing: 2px;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .part {
    margin-top: clamp(72px, 10vw, 120px);
    scroll-margin-top: 100px;
  }
  .part__eyebrow {
    font-size: 13px;
    color: var(--accent);
  }
  .part__title {
    margin-top: 12px;
    max-width: 820px;
    font-size: clamp(30px, 4.6vw, 52px);
  }
  .part__lead {
    margin-top: 16px;
    max-width: 680px;
    color: var(--text-muted);
  }
  .part__note {
    margin-top: 18px;
    color: var(--text-muted);
  }
  #services :global(.plugins) {
    margin-top: 32px;
  }

  .pricing {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 16px;
    margin-top: 32px;
  }
  .price {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: clamp(24px, 4vw, 36px);
    border: 1px solid #343947;
    border-radius: var(--radius-lg);
    background: var(--grad-ink);
    color: #eef0f5;
  }
  .price__tag {
    font-size: 12px;
    color: #a1a8b8;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .price__value {
    font-size: clamp(56px, 8vw, 88px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    background: linear-gradient(100deg, #f1f2f7 0%, #9aa6ff 50%, #ff7aa8 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .price__value span {
    font-size: 20px;
    letter-spacing: 0;
  }
  .price__note {
    margin-bottom: 10px;
    font-size: 14.5px;
    color: #a1a8b8;
  }
  .offers {
    display: grid;
    gap: 12px;
    padding: 0;
    list-style: none;
  }
  .offers li {
    display: flex;
    gap: 16px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .offers__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--ok) 12%, transparent);
    font-size: 22px;
  }
  .offers__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 18px;
  }
  .offers__free {
    padding: 2px 8px;
    border-radius: 6px;
    background: color-mix(in srgb, var(--ok) 14%, transparent);
    color: var(--ok);
    font-size: 11px;
    letter-spacing: 0.06em;
  }
  .offers__text {
    margin-top: 4px;
    font-size: 15px;
    color: var(--text-muted);
  }

  .markets {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
    padding: 0;
    list-style: none;
    font-size: 13.5px;
  }
  .markets li {
    padding: 8px 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-elev);
  }
  .trust {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 16px;
    margin-top: 24px;
    padding: 0;
    list-style: none;
  }
  .trust__item {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .trust__icon {
    font-size: 28px;
  }
  .trust__title {
    margin-top: 12px;
    font-size: 19px;
  }
  .trust__text {
    margin-top: 8px;
    font-size: 15px;
    color: var(--text-muted);
  }
  @media (max-width: 860px) {
    .pricing {
      grid-template-columns: 1fr;
    }
  }

  .log {
    margin-top: 32px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--grad-ink);
    color: #c9cfdb;
    overflow: hidden;
  }
  .log__bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 16px;
    border-bottom: 1px solid #23262f;
    font-size: 12px;
    color: #a1a8b8;
  }
  .log__dots {
    display: flex;
    gap: 6px;
  }
  .log__dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #343947;
  }
  .log__count {
    margin-left: auto;
    color: #3ddc97;
  }
  .log__list {
    list-style: none;
    padding: 10px 0;
    font-size: clamp(12px, 1.2vw, 13.5px);
  }
  .log__list li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 24px;
    padding: 10px 18px;
    border-left: 2px solid transparent;
    transition: background-color 0.2s, border-color 0.2s;
  }
  .log__list li:hover {
    background: rgb(255 255 255 / 0.04);
    border-left-color: #3ddc97;
  }
  .log__error b {
    font-weight: 500;
    color: #ff7a85;
  }
  .log__fix {
    color: #3ddc97;
  }

  .proof {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 16px;
    margin-top: 32px;
  }
  .proof li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .proof__value {
    font-size: clamp(36px, 4.6vw, 52px);
    font-weight: 600;
    line-height: 1;
    color: var(--accent);
  }
  .proof__text {
    color: var(--text-muted);
  }

  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 16px;
    margin-top: 32px;
    padding: 0;
    counter-reset: none;
  }
  .step {
    position: relative;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
  }
  .step__num {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--grad-btn);
    color: #fff;
    font-size: 14px;
    font-weight: 600;
  }
  .step__title {
    margin-top: 18px;
    font-size: 20px;
  }
  .step__text {
    margin-top: 8px;
    font-size: 15.5px;
    color: var(--text-muted);
  }

  .final {
    position: relative;
    margin-top: clamp(72px, 10vw, 120px);
    padding: clamp(32px, 6vw, 72px);
    border: 1px solid #343947;
    border-radius: calc(var(--radius-lg) + 8px);
    background: var(--grad-ink);
    color: #eef0f5;
    text-align: center;
    overflow: hidden;
    isolation: isolate;
    scroll-margin-top: 100px;
    --text: #eef0f5;
    --btn-surface: linear-gradient(180deg, #252935 0%, #12141b 100%);
    --btn-highlight: inset 0 1px 0 rgb(255 255 255 / 0.08);
    --line: #23262f;
    color-scheme: dark;
  }
  .final::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(600px circle at 50% 0%, rgb(143 156 255 / 0.2), transparent 65%);
  }
  .final__status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 12.5px;
    color: #3ddc97;
  }
  .final__title {
    margin: 18px auto 0;
    max-width: 760px;
    font-size: clamp(30px, 5vw, 58px);
  }
  .final__lead {
    margin: 18px auto 0;
    max-width: 560px;
    color: #a1a8b8;
  }
  .final__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }
</style>
